.detail-page { padding-bottom: 140rpx; background: #fff; min-height: 100vh; }
.gallery { width: 100%; background: #e9ece5; }
.gallery-img { width: 100%; height: 100%; }
.gallery-count { position: absolute; right: 28rpx; top: 620rpx; z-index: 3; background: rgba(28,28,30,.5); color: #fff; font-size: 22rpx; padding: 4rpx 18rpx; border-radius: 99px; }

.pad { padding: 32rpx; }
.name { font-size: 44rpx; font-weight: 800; color: #172e25; }
.latin { color: #8a8a8e; font-size: 26rpx; margin-top: 6rpx; }
.italic { font-style: italic; }

.tags-row { display: flex; gap: 14rpx; margin: 24rpx 0 8rpx; flex-wrap: wrap; }
.cat-tag { background: #edf1e8; color: #3b5a2c; }
.prob-tag { background: #172e25; color: #fff; }

.section-title { margin: 44rpx 0 16rpx; padding-left: 16rpx; border-left: 6rpx solid #718b36; font-size: 30rpx; font-weight: 700; }

.facts-row { display: grid; gap: 16rpx; }
.facts-item { padding: 16rpx 20rpx; background: #f4f6f1; border-radius: 16rpx; }
.facts-label { display: block; font-size: 22rpx; color: #8a8a8e; margin-bottom: 4rpx; }
.facts-value { font-size: 27rpx; line-height: 1.6; color: #172e25; }
.facts-source { margin: 14rpx 4rpx 0; font-size: 22rpx; color: #8a8a8e; }
.trait { font-size: 28rpx; line-height: 1.9; color: #2e3b31; }

.sound-card { margin: 28rpx 0; padding: 18rpx 20rpx; background: #edf1e6; border-radius: 20rpx; }
.sound-row { display: flex; align-items: center; gap: 20rpx; }
.sound-play { flex: none; width: 72rpx; height: 72rpx; border-radius: 50%; background: #172e25; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }
.sound-play.playing { background: #3b5a2c; }
.sound-title { flex: 1; font-size: 27rpx; font-weight: 600; }
.rel-tag { display: inline-block; margin-left: 10rpx; padding: 0 12rpx; border-radius: 99px; background: #dce8b9; color: #3b5a2c; font-size: 20rpx; font-weight: 600; }
.sound-info { flex: none; width: 60rpx; height: 60rpx; text-align: center; line-height: 60rpx; color: #5b6f56; font-size: 30rpx; }
.sound-detail { margin-top: 14rpx; padding-top: 12rpx; border-top: 1px solid rgba(60,60,67,.2); }
.sound-note { font-size: 24rpx; line-height: 1.7; color: #4e5d52; }
.sound-credit { margin-top: 8rpx; font-size: 22rpx; color: #617065; }

.story-eyebrow { font-size: 22rpx; color: #8a8a8e; margin-top: 32rpx; }
.story-title { font-size: 34rpx; font-weight: 800; margin: 10rpx 0 16rpx; }
.story-lead { font-size: 27rpx; line-height: 1.85; color: #344c3e; border-left: 4rpx solid #acbd68; padding-left: 18rpx; margin-bottom: 20rpx; }
.story-h4 { font-size: 28rpx; font-weight: 700; margin: 24rpx 0 8rpx; }
.story-p { font-size: 27rpx; line-height: 1.9; color: #2e3b31; }
.field-note { margin: 30rpx 0; padding: 22rpx; background: #e7ecd8; border-radius: 16rpx; }

.compare-row { display: flex; gap: 16rpx; overflow-x: auto; }
.compare-card { flex: none; width: 220rpx; border: 1px solid #dce1d7; border-radius: 16rpx; overflow: hidden; }
.compare-card image { width: 220rpx; height: 160rpx; }
.compare-text { padding: 12rpx; font-size: 22rpx; color: #4e5d52; line-height: 1.6; }
.compare-name { display: block; font-weight: 700; color: #172e25; font-size: 25rpx; }

.credit { margin-top: 40rpx; padding-top: 20rpx; border-top: 1px solid #dce1d7; font-size: 20rpx; color: #8a8a8e; line-height: 1.9; }

.detail-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -1px 0 rgba(60,60,67,.29); }
.primary-btn { height: 88rpx; line-height: 88rpx; text-align: center; background: #172e25; color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 700; }
.primary-btn.seen { background: #e2ebc5; color: #172e25; }
