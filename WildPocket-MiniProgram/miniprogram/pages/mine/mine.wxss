.mine-page { padding: 32rpx; background: #fff; min-height: 100vh; }
.page-title { font-size: 40rpx; font-weight: 800; margin-bottom: 24rpx; }

.summary-card { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; background: #172e25; color: #fff; border-radius: 28rpx; }
.summary-count { font-size: 40rpx; font-weight: 800; }
.summary-label { font-size: 22rpx; color: #cdd8c9; margin-top: 6rpx; }
.meter { flex: 1; height: 12rpx; background: rgba(255,255,255,.2); border-radius: 99px; overflow: hidden; }
.meter-fill { height: 100%; background: #d8e789; }
.summary-percent { font-size: 26rpx; font-weight: 700; color: #e2edb1; }

.offline-row { display: flex; align-items: center; gap: 16rpx; height: 88rpx; margin: 24rpx 0 4rpx; padding: 0 24rpx; background: #f2f2f7; border-radius: 20rpx; }
.offline-icon { font-size: 30rpx; color: #172e25; }
.offline-title { flex: 1; font-size: 27rpx; font-weight: 600; }
.offline-status { font-size: 25rpx; color: #8a8a8e; }
.chev { color: #c7c7cc; font-size: 24rpx; }
.offline-progress { height: 8rpx; margin: 0 24rpx 20rpx; border-radius: 99px; background: #e7ebe3; overflow: hidden; }
.offline-progress-fill { height: 100%; background: #8ca44c; }

.rarity-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14rpx; margin: 20rpx 0; }
.rarity-card { padding: 18rpx 16rpx 16rpx; border: 1px solid #dfe5d8; border-radius: 20rpx; background: #fff; }
.rarity-card.active { border-color: #7d963f; background: #f2f6e8; box-shadow: 0 0 0 2rpx #d9e4bc; }
.rarity-top { display: flex; justify-content: space-between; font-size: 24rpx; font-weight: 700; }
.rarity-pct { color: #899489; font-size: 20rpx; font-weight: 600; }
.rarity-count { font-size: 22rpx; margin: 6rpx 0; }
.rarity-bar { height: 8rpx; border-radius: 99px; background: #e7ebe3; overflow: hidden; }
.rarity-bar-fill { height: 100%; background: #8ca44c; }

.collection-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24rpx 12rpx; margin-top: 8rpx; }
.collection-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.collection-item image { width: 108rpx; height: 108rpx; border-radius: 50%; border: 4rpx solid #dfe5d8; }
.collection-item.collected image { border-color: #829a42; box-shadow: 0 0 0 4rpx #e2ebc5; }
.collection-item image.grey { opacity: .34; filter: grayscale(1); }
.collection-name { font-size: 20rpx; color: #172e25; text-align: center; }
.collection-item:not(.collected) .collection-name { color: #879086; }
